# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# --- What to watch -----------------------------------------------------------
TICKETS_URL=https://www.yorkcityfootballclub.co.uk/tickets-and-hospitality/match-tickets/home-tickets
HOME_TEAM=York City
# Listings containing any of these words are ignored (comma separated)
EXCLUDE_KEYWORDS=parking,hospitality,season ticket,membership,voucher

# --- Browser -----------------------------------------------------------------
# Set to false if the site blocks headless browsers (a window will pop up each run)
HEADLESS=true
# Optional: a dedicated Chrome profile folder (keeps cookies between runs). Leave blank normally.
BROWSER_PROFILE=
PAGE_TIMEOUT_MS=30000

# --- Phone alerts via ntfy (REQUIRED) -----------------------------------------
# Install the ntfy app (Android/iOS), subscribe to a hard-to-guess topic name, and put
# the exact same name here. Anyone who knows the name can read it, so make it random.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Only needed for a protected/self-hosted topic
NTFY_TOKEN=

# --- Files -------------------------------------------------------------------
STATE_FILE=data/seen_fixtures.json
# Leave blank to log to the console only
LOG_FILE=logs/ycfc_tickets.log
