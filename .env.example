# Settings for running the checker on your own PC.
# Copy this file to .env and fill it in. .env is git-ignored - never commit it.
# (On GitHub Actions these come from repository secrets/variables instead - see README.)

# --- Phone notifications via ntfy (REQUIRED) -----------------------------------
# Install the ntfy app (Android/iOS), subscribe to a hard-to-guess topic name, and put
# the exact same name here. Anyone who knows the name can read it, so make it random.
NTFY_TOPIC=
# Optional: picture shown as the notification's icon (Android). Defaults to the club crest.
#NTFY_ICON=

# --- What to notify about ------------------------------------------------------
TICKETS_ENABLED=true
NEWS_ENABLED=true
# Only these news categories (comma separated). Leave blank for all of them.
# The club uses: Club News, Mens, Womens, Academy, Ticket News, Commercial, Events,
# Community, General
NEWS_CATEGORIES=
# Ticket listings containing any of these words are ignored (comma separated)
EXCLUDE_KEYWORDS=parking,hospitality,season ticket,membership,voucher

# --- Files -------------------------------------------------------------------
STATE_FILE=data/state.json
# Leave blank to log to the console only
LOG_FILE=logs/ycfc_tickets.log

# --- Rarely needed -----------------------------------------------------------
# How fixtures are read: api (fast, default), browser (loads the page in Chromium;
# needs: pip install -e ".[browser]" and python -m playwright install chromium),
# or auto (api first, browser if that fails).
#TICKETS_SOURCE=auto
#HEADLESS=true
